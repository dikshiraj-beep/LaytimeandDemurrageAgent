# Copy this file to .env and fill in ONE provider.

# --- LLM provider: anthropic | openai | azure | mock
# mock = runs fully offline with deterministic heuristics (no API key). Good for a first run.
LLM_PROVIDER=mock

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Azure OpenAI (if your company uses Azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Embeddings for the vector DB: default | openai | hash
# default = Chroma's built-in MiniLM model (downloads ~80 MB the first time, then offline)
# hash    = offline fallback, no download (lower retrieval quality)
EMBEDDINGS=default
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Agent behaviour
MAX_RETRIEVAL_ATTEMPTS=3
MAX_VERIFY_ATTEMPTS=2
RETRIEVAL_TOP_K=6
TIME_BAR_WARNING_DAYS=30
# Fix "today" for time-bar checks so demos are repeatable (leave blank for the real date)
AS_OF_DATE=2026-10-01
